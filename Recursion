Fibonacci ---> f(n) =f(n-1) +f(n-2);

int fib(int n){
     if (n<= 0){ 
      return 0;   
     }
     else if(n==1){
         return 1;
     } 
    else {
        return fib(n-1)+fib(n-2);
       }
}
